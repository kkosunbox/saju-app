{
  "expo": {
    "name": "운Pick",
    "slug": "woonpick",
    "scheme": "woonpick",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "description": "오늘의 운, 하나만 Pick! 사주 · 점성술 · MBTI · 혈액형을 겹쳐 읽는 오늘의 운세.",
    "primaryColor": "#22293F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.woonpick.ios",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "운Pick",
        "CFBundleName": "운Pick",
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.woonpick.android",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7FD0FF"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "운Pick · 오늘의 운, 하나만 Pick!",
      "shortName": "운Pick",
      "themeColor": "#FFFFFF",
      "backgroundColor": "#FFFFFF",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "부적과 운세 카드 이미지를 사진첩에 저장하려면 사진 추가 권한이 필요해요.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#3DB9FE"
        }
      ],
      "expo-iap",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cddb3374-f974-4221-94c3-09a717e81956"
      }
    },
    "owner": "errcode2323",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/cddb3374-f974-4221-94c3-09a717e81956"
    }
  }
}
