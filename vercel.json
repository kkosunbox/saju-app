{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/invite/:token", "destination": "/invite/[token]" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
