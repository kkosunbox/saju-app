{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "EXPO_PUBLIC_API_URL=/api npm run build:web -- --clear",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/invite/:token", "destination": "/invite/[token]" },
    { "source": "/consult/:id", "destination": "/consult/[id]" }
  ]
}
