{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "EXPO_PUBLIC_API_URL=/api npm run build:web -- --clear",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/terms", "destination": "/legal/terms", "permanent": true },
    { "source": "/privacy", "destination": "/legal/privacy", "permanent": true }
  ],
  "rewrites": [
    { "source": "/p/:token", "destination": "/p/[token]" },
    { "source": "/profiles/:id(\\d+)", "destination": "/profiles/[id]" },
    { "source": "/invite/:token", "destination": "/invite/[token]" },
    { "source": "/consult/:id", "destination": "/consult/[id]" },
    { "source": "/r/:token", "destination": "/r/[token]" }
  ]
}
